// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// ---------------------------------------------------------------------------
// reb7y — profit & loss tracking models
// Everything is scoped by `shop` (the myshopify.com domain) for multi-store safety.
// ---------------------------------------------------------------------------

/// A single material / part you buy (a box, bubble wrap, a card, a sticker...).
/// Cost is expressed per `unit` so quantities on products multiply cleanly.
model Material {
  id                String    @id @default(cuid())
  shop              String
  name              String
  unit              String    @default("piece") // built-in or custom unit name
  costPerUnit       Float // cost of ONE unit, in the shop currency (EGP)
  stock             Float     @default(0) // units bought / on hand
  lowStockThreshold Float     @default(0) // warn when remaining <= this (0 = off)
  archived          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  bomLines          BomLine[]
  prices            MaterialPrice[]

  @@index([shop])
}

// ---------------------------------------------------------------------------
// Dated cost history
//
// Costs change over time, and a report must show what an order ACTUALLY cost
// when it happened. Without this, raising a box from 15 to 17 EGP silently
// rewrites the profit of every order ever placed.
//
// The Material / ProductCost / DeliveryZone rows above stay the "current"
// values the merchant edits. The tables below record what each cost was from a
// given day onward, and the reports resolve every order against its own date.
//
// Resolution rule (see resolveAsOf in app/lib/costHistory.server.ts):
//   - use the newest entry whose effectiveFrom is on or before the order's day
//   - if the order predates every entry, use the OLDEST entry, so entering
//     costs today does not leave last month's orders with no cost at all
// ---------------------------------------------------------------------------

/// What one unit of a material cost from `effectiveFrom` onward.
model MaterialPrice {
  id            String   @id @default(cuid())
  shop          String
  materialId    String
  material      Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  costPerUnit   Float
  effectiveFrom String // YYYY-MM-DD
  note          String?
  createdAt     DateTime @default(now())

  // One price per material per day: editing twice in a day replaces the entry
  // rather than leaving two rows competing for the same date.
  @@unique([shop, materialId, effectiveFrom])
  @@index([shop, materialId, effectiveFrom])
}

/// What one unit of a product cost from `effectiveFrom` onward — a complete
/// snapshot, so a later recipe or material change cannot alter it.
/// Rewritten whenever a material price, a recipe line, or the product's own
/// factory/other cost changes.
model ProductCostVersion {
  id                    String   @id @default(cuid())
  shop                  String
  productId             String // Shopify product GID
  effectiveFrom         String // YYYY-MM-DD
  materialCost          Float    @default(0) // sum of recipe lines at this date
  returnMaterialCost    Float    @default(0) // only lines flagged countOnReturn
  factoryCost           Float    @default(0)
  otherCost             Float    @default(0)
  returnDeliveryMode    String   @default("settings")
  returnDeliveryPercent Float    @default(100)
  /// What triggered this version: edit | material | recipe | seed
  reason                String   @default("edit")
  createdAt             DateTime @default(now())

  @@unique([shop, productId, effectiveFrom])
  @@index([shop, productId, effectiveFrom])
}

/// The real courier cost of a delivery zone from `effectiveFrom` onward.
model DeliveryZonePrice {
  id            String       @id @default(cuid())
  shop          String
  zoneId        String
  zone          DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  realCost      Float
  effectiveFrom String // YYYY-MM-DD
  note          String?
  createdAt     DateTime     @default(now())

  @@unique([shop, zoneId, effectiveFrom])
  @@index([shop, zoneId, effectiveFrom])
}

/// The money rules as they stood from `effectiveFrom` onward — a full snapshot,
/// so raising a COD fee today cannot restate what last month's orders cost you.
/// Mirrors the fee/deposit/return fields of Settings.
model SettingsVersion {
  id                    String   @id @default(cuid())
  shop                  String
  effectiveFrom         String // YYYY-MM-DD
  paymentFeePercent     Float    @default(0)
  paymentFeeFlat        Float    @default(0)
  codFeePercent         Float    @default(0)
  codRoundTripDefault   Boolean  @default(false)
  returnDeliveryMode    String   @default("full")
  returnDeliveryPercent Float    @default(100)
  returnDeliveryFixed   Float    @default(0)
  depositMode           String   @default("none")
  depositValue          Float    @default(0)
  createdAt             DateTime @default(now())

  @@unique([shop, effectiveFrom])
  @@index([shop, effectiveFrom])
}

/// A worker's monthly salary from `effectiveFrom` onward, so a raise does not
/// rewrite what payroll cost in earlier months.
model WorkerSalary {
  id            String   @id @default(cuid())
  shop          String
  workerId      String
  worker        Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  monthlySalary Float
  effectiveFrom String // YYYY-MM-DD
  createdAt     DateTime @default(now())

  @@unique([shop, workerId, effectiveFrom])
  @@index([shop, workerId, effectiveFrom])
}

/// A recurring expense's amount from `effectiveFrom` onward — a rent increase
/// should not change what rent cost before it happened.
model ExpenseAmount {
  id            String   @id @default(cuid())
  shop          String
  expenseId     String
  expense       Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  amount        Float
  effectiveFrom String // YYYY-MM-DD
  createdAt     DateTime @default(now())

  @@unique([shop, expenseId, effectiveFrom])
  @@index([shop, expenseId, effectiveFrom])
}

/// A custom measurement unit the merchant added (on top of the built-in ones).
model CustomUnit {
  id        String   @id @default(cuid())
  shop      String
  name      String
  createdAt DateTime @default(now())

  @@unique([shop, name])
  @@index([shop])
}

/// Cost header attached to a Shopify product. Its material cost is the sum of
/// its BomLines; `otherCost` covers anything not tracked as a material
/// (labour, tape, handling...). One row per Shopify product per shop.
model ProductCost {
  id                    String    @id @default(cuid())
  shop                  String
  productId             String // Shopify product GID, e.g. gid://shopify/Product/123
  title                 String    @default("")
  factoryCost           Float     @default(0) // manufacturing/factory cost per item in shop currency
  otherCost             Float     @default(0) // extra per-item cost (labour / misc) in EGP
  returnDeliveryMode    String    @default("settings") // settings | full | percent
  returnDeliveryPercent Float     @default(100) // used when mode = percent
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  bomLines              BomLine[]

  @@unique([shop, productId])
  @@index([shop])
}

/// One line in a product's bill of materials: "20 cm of bubble wrap".
model BomLine {
  id            String      @id @default(cuid())
  productCostId String
  productCost   ProductCost @relation(fields: [productCostId], references: [id], onDelete: Cascade)
  materialId    String
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Restrict)
  quantity      Float       @default(1)
  countOnReturn Boolean     @default(false)

  @@index([productCostId])
  @@index([materialId])
}

/// Total ad spend for one calendar day. One row per day per shop.
model AdSpend {
  id        String   @id @default(cuid())
  shop      String
  date      String // YYYY-MM-DD (kept as a string so a "day" is timezone-stable)
  amount    Float // total spent on ads that day, in EGP
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, date])
  @@index([shop])
}

/// A delivery zone with the typical REAL courier cost (what the express company
/// charges you), used as the default before any per-order override.
/// `keywords` is a comma-separated list matched against the order's city/province.
model DeliveryZone {
  id        String   @id @default(cuid())
  shop      String
  name      String // e.g. "Cairo", "Giza", "Alexandria", "Delta", "Upper Egypt"
  keywords  String   @default("") // comma-separated match terms, case-insensitive
  realCost  Float    @default(0) // typical real courier cost in EGP
  isDefault Boolean  @default(false) // fallback when no zone matches the address
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  prices    DeliveryZonePrice[]

  @@index([shop])
}

/// Per-order overrides layered on top of the live Shopify order data:
/// the real delivery cost for THIS order and the delivery outcome
/// (delivered / rejected / returned). One row per order per shop.
model OrderCost {
  id               String   @id @default(cuid())
  shop             String
  orderId          String // Shopify order GID
  name             String   @default("") // cached order name, e.g. "#1001"
  realDeliveryCost Float? // override; when null, resolved from the matching zone
  deliveryOutcome  String   @default("delivered") // delivered | rejected | returned
  roundTrip        Boolean  @default(false) // rejected/returned => paid shipping both ways
  depositMode      String   @default("settings") // settings | none | fixed | percent_real | percent_shopify
  depositValue     Float    @default(0) // amount or percent based on depositMode
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([shop, orderId])
  @@index([shop])
}

/// Per-shop configuration for the money math.
model Settings {
  id                    String   @id @default(cuid())
  shop                  String   @unique
  currency              String   @default("EGP")
  paymentFeePercent     Float    @default(0) // card/gateway fee as a % of revenue
  paymentFeeFlat        Float    @default(0) // flat fee per order
  codFeePercent         Float    @default(0) // extra COD collection fee as a % (0 = same as card)
  codRoundTripDefault   Boolean  @default(false) // rejected COD counts delivery x2 by default
  returnDeliveryMode    String   @default("full") // full | percent | fixed
  returnDeliveryPercent Float    @default(100) // used when mode = percent
  returnDeliveryFixed   Float    @default(0) // used when mode = fixed
  depositMode           String   @default("none") // none | fixed | percent_real | percent_shopify
  depositValue          Float    @default(0) // amount or percent based on depositMode
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

/// Any business cost that isn't per-order: Shopify subscription, electricity,
/// water, rent, a one-off repair, etc. Recurring ones are prorated across a
/// report's date range; one-time ones count on their date.
model Expense {
  id         String   @id @default(cuid())
  shop       String
  label      String // free text — "Shopify plan", "Electricity", "Fridge repair"…
  category   String   @default("other") // subscription | bill | urgent | other
  amount     Float
  frequency  String   @default("monthly") // once | daily | weekly | monthly
  date       String? // YYYY-MM-DD, used when frequency = once
  dayOfMonth Int? // reminder of which day it's usually paid (monthly)
  active     Boolean  @default(true)
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  amounts    ExpenseAmount[]

  @@index([shop])
}

/// A worker/employee. Monthly salary is prorated into reports; one-off gifts and
/// bonuses are logged as WorkerPayment rows.
model Worker {
  id            String          @id @default(cuid())
  shop          String
  name          String
  age           Int?
  monthlySalary Float           @default(0)
  active        Boolean         @default(true)
  note          String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  payments      WorkerPayment[]
  salaries      WorkerSalary[]

  @@index([shop])
}

/// A dated, timestamped bonus/gift (or other one-off payment) to a worker.
model WorkerPayment {
  id        String   @id @default(cuid())
  shop      String
  workerId  String
  worker    Worker   @relation(fields: [workerId], references: [id], onDelete: Cascade)
  amount    Float
  type      String   @default("bonus") // bonus | gift | other
  date      String // YYYY-MM-DD occurrence date
  note      String?
  createdAt DateTime @default(now()) // exact time it was logged

  @@index([shop])
  @@index([workerId])
}

/// "When Shopify sends me this line, cost it as that product instead."
///
/// Shopify does not always send a bundle as its own product. A bundle sale can
/// arrive carrying a component's product id while charging the bundle's price,
/// which silently costs the order as the component. The merchant owns the
/// mapping because only they know what they actually sold.
///
/// A rule may pin a variant and/or a unit price; the most specific match wins,
/// so a Curved Vase sold at its own price keeps its own cost.
model LineCostRule {
  id              String   @id @default(cuid())
  shop            String
  productId       String // the Shopify product GID that arrives on the order line
  variantId       String? // optional: only this variant
  unitPrice       Float? // optional: only when sold at this price per unit
  targetProductId String // the ProductCost.productId to charge instead
  label           String   @default("") // human note, e.g. "Natural Wood Decor Bundle"
  createdAt       DateTime @default(now())

  @@unique([shop, productId, variantId, unitPrice])
  @@index([shop])
}
